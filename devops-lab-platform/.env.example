# Copy this file to `.env` and adjust if needed.
#
# POSTGRES_PASSWORD and SECRET_KEY are generated automatically the first time
# you run `docker compose up -d` (one-shot `secrets-init` service) and stored
# in the `app_secrets` volume, so they stay stable across restarts. Uncomment
# any line below to pin an explicit value instead of the generated one.
#
# POSTGRES_PASSWORD=
# SECRET_KEY=
# LABS_HOST_PATH=/absolute/path/to/Opslance/labs
#   REQUIRED on macOS / Docker Desktop for labs that use bind mounts (20 of the
#   64 linux labs do). The worker cannot see Mac paths from inside the container.
#   Example: LABS_HOST_PATH=/Users/you/dev/Opslance/labs
# BACKEND_PORT=8000                       # change if host port 8000 is taken
                                          # (UI on port 80 keeps working either way)

# Super admin login (used by the /login page)
ADMIN_EMAIL=admin@opslance.local
ADMIN_PASSWORD=change_me_before_first_start
ADMIN_FULL_NAME=Admin

# CORS — empty by default: the app is same-origin through nginx, so no
# cross-origin access is granted. List browser origins (comma-separated) only
# if you integrate external frontends, e.g.
# CORS_ORIGINS=https://staging.opslance.com,https://partner.example.com
# CORS_ORIGINS=

